{
  "name": "tilderadio/site",
  "description": "TildeRadio website and DJ authentication",
  "type": "project",
  "license": "GPL-2.0-only",
  "require": {
    "php": ">=8.4",
    "ext-curl": "*",
    "ext-json": "*",
    "ext-pdo": "*",
    "ext-pdo_sqlite": "*",
    "monolog/monolog": "^3.0"
  },
  "require-dev": {
    "friendsofphp/php-cs-fixer": "^3.0",
    "phpstan/phpstan": "^2.0",
    "phpunit/phpunit": "^12.0"
  },
  "autoload": {
    "psr-4": {"TildeRadio\\Site\\DjAuth\\": "lib/DjAuth/", "TildeRadio\\Site\\Admin\\": "lib/Admin/"}
  },
  "scripts": {
    "test": "phpunit",
    "analyse": "phpstan analyse --no-progress",
    "format": "php-cs-fixer fix",
    "format:check": "php-cs-fixer fix --dry-run --diff",
    "lint:auth": "@php bin/lint-dj-auth.php"
  },
  "config": {"sort-packages": true, "allow-plugins": false, "platform": {"php": "8.4.0"}}
}
