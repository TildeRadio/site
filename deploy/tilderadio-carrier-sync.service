[Unit]
Description=Synchronize TildeRadio website with Carrier
After=tilderadio-bot.service

[Service]
Type=oneshot
User=nginx
Group=nginx
SupplementaryGroups=tilderadio-carrier
WorkingDirectory=/usr/share/nginx/tilderadio.org
ExecStart=/usr/bin/php /usr/share/nginx/tilderadio.org/bin/carrier-sync.php --sync
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/tilderadio-dj-auth-site
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
TimeoutStartSec=110
