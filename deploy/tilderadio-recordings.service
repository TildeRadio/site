[Unit]
Description=Discover TildeRadio AzuraCast recordings for review
After=tilderadio-bot.service tilderadio-carrier-sync.service

[Service]
Type=oneshot
User=nginx
Group=nginx
SupplementaryGroups=tilderadio-carrier
WorkingDirectory=/usr/share/nginx/tilderadio.org
ExecStart=/usr/bin/php /usr/share/nginx/tilderadio.org/bin/carrier-recordings.php
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/tilderadio-dj-auth-site /var/lib/tilderadio-recordings
TimeoutStartSec=600
